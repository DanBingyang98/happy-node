<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.danby.happynode.auth.domain.mapper.UserDOMapper">
    <resultMap id="BaseResultMap" type="com.danby.happynode.auth.domain.dataobject.UserDO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="username" property="username" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>
    <insert id="insert" parameterType="com.danby.happynode.auth.domain.dataobject.UserDO">
        INSERT INTO t_user (username, create_time, update_time)
        VALUES (#{username}, #{createTime}, #{updateTime})
    </insert>
    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        DELETE FROM t_user WHERE id=#{id}
    </delete>
    <update id="updateByPrimaryKey" parameterType="com.danby.happynode.auth.domain.dataobject.UserDO">
        UPDATE t_user
        SET username=#{username},
            update_time=#{updateTime},
            create_time=#{createTime}
        WHERE id = #{id}
    </update>
    <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT id, username, create_time, update_time
        FROM t_user
        WHERE id = #{id}
    </select>
</mapper>